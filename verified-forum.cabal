cabal-version: 3.0
name: verified-forum
version: 0.1.0.0
build-type: Simple
license: MIT

library
  hs-source-dirs: security, generated
  exposed-modules: VerifiedTenant
  other-modules: TenantCore
  default-language: GHC2021
  ghc-options: -Wall -O0
  build-depends: base >=4.18 && <5, bytestring, text

common core
  default-language: GHC2021
  hs-source-dirs: generated, src
  ghc-options: -Wall -O0
  build-depends: base >=4.18 && <5, aeson >=2.2 && <3, bytestring, text, containers, scientific, verified-forum
  other-modules: ForumCore, ClientCore, RevocationCore, Adapter, ProgramAdapter, TenantAdapter

executable verified-forum
  import: core
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  build-depends: wai, warp, http-types
  other-modules: Server

test-suite core-tests
  import: core
  type: exitcode-stdio-1.0
  hs-source-dirs: test, build/model
  main-is: CoreSpec.hs
  build-depends: QuickCheck >=2.14 && <3
  other-modules: Oracle, MAlonzo.Code.ForumCore, MAlonzo.RTE,
    MAlonzo.Code.Agda.Builtin.List,
    MAlonzo.Code.Agda.Builtin.Bool,
    MAlonzo.Code.Agda.Builtin.Equality,
    MAlonzo.Code.Agda.Builtin.FromNat,
    MAlonzo.Code.Agda.Builtin.FromString,
    MAlonzo.Code.Agda.Builtin.String,
    MAlonzo.Code.Agda.Primitive,
    MAlonzo.Code.Haskell.Prim,
    MAlonzo.Code.Haskell.Prim.Maybe

test-suite program-tests
  import: core
  type: exitcode-stdio-1.0
  hs-source-dirs: test, build/model
  main-is: ProgramSpec.hs
  build-depends: QuickCheck >=2.14 && <3
  other-modules: Oracle, ClientOracle, MAlonzo.Code.ForumCore, MAlonzo.Code.ClientCore,
    MAlonzo.Code.ClientModel, MAlonzo.RTE,
    MAlonzo.Code.Agda.Builtin.List, MAlonzo.Code.Haskell.Prim.Bool,
    MAlonzo.Code.Agda.Builtin.Bool,
    MAlonzo.Code.Agda.Builtin.Equality,
    MAlonzo.Code.Agda.Builtin.FromNat,
    MAlonzo.Code.Agda.Builtin.FromString,
    MAlonzo.Code.Agda.Builtin.String,
    MAlonzo.Code.Agda.Primitive,
    MAlonzo.Code.Haskell.Prim,
    MAlonzo.Code.Haskell.Prim.Maybe

test-suite tenant-tests
  import: core
  type: exitcode-stdio-1.0
  hs-source-dirs: test, build/model
  main-is: TenantSpec.hs
  build-depends: QuickCheck >=2.14 && <3
  other-modules: TenantCore, MAlonzo.Code.TenantCore, MAlonzo.RTE,
    MAlonzo.Code.Agda.Builtin.Bool,
    MAlonzo.Code.Agda.Builtin.Equality,
    MAlonzo.Code.Agda.Builtin.FromNat,
    MAlonzo.Code.Agda.Builtin.FromString,
    MAlonzo.Code.Agda.Builtin.String,
    MAlonzo.Code.Agda.Primitive,
    MAlonzo.Code.Haskell.Prim,
    MAlonzo.Code.Haskell.Prim.Maybe
