cabal-version: 3.0
name: verified-forum
version: 0.1.0.0
build-type: Simple
license: MIT

common core
  default-language: GHC2021
  hs-source-dirs: generated, src
  ghc-options: -Wall -O0
  build-depends: base >=4.18 && <4.19, aeson ==2.3.2.0, bytestring, text, containers, scientific
  other-modules: ForumCore, Adapter

executable verified-forum
  import: core
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  build-depends: wai, warp, http-types
  other-modules: Server

test-suite core-tests
  import: core
  type: exitcode-stdio-1.0
  hs-source-dirs: test, build/model
  main-is: CoreSpec.hs
  build-depends: QuickCheck ==2.18.0.0
  other-modules: Oracle, MAlonzo.Code.ForumCore, MAlonzo.RTE
